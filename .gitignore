# entorno Python (pesado, reproducible vía requirements.txt)
.venv/
__pycache__/
*.pyc

# artefactos de build/instalación editable (pip install -e .)
*.egg-info/
build/
dist/

# estado runtime / logs
saga.log*
livekit_agent.log*
livekit_server.log*
session.json
.saga-settings.json
*.wav

# secretos: API keys (Deepgram, etc). NUNCA se commitea.
.env
.env.local

# blacklist de plugins del daemon: lista personal, local. Va la plantilla .example al repo.
configs/plugins-blacklist.json

# .claude/ (superpowers + config local): NO se commitea. El CLAUDE.md de raíz (workflow AI-DLC) SÍ.
.claude/
docs/superpowers/

# Framework AI-DLC VERSIONADO en el repo (self-contained): workflow CLAUDE.md (raíz) + reglas
# .aidlc-rule-details/ + bitácora/estado/artefactos aidlc-docs/. Los secretos y el runtime siguen
# ignorados arriba (.env*, session.json, .saga-settings.json, configs/plugins-blacklist.json, logs).

# temporales del sistema
/tmp/
# models/ son insumos pesados (datasets, TTS, features ~22GB) -> NO se versionan.
# Excepción: el modelo wake word entrenado (.onnx, ~166KB) SÍ va al repo.
# (Se ignora el CONTENIDO con models/* para poder re-incluir el .onnx; ignorar el dir
# entero con models/ impediría la excepción.)
models/*
!models/hey_saga/
models/hey_saga/*
!models/hey_saga/hey_saga.onnx

# artefactos de testing/visual (no van al repo)
.playwright-mcp/
orb-core-*.png
graphify-out/
.graphifyignore
.aidlc/
